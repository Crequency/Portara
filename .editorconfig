# Portara 统一代码风格
# 编辑器（VS / VS Code / Rider）均读取本文件，避免跨机格式漂移。
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,ts,js,vue,css,scss,html}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{csproj,slnx,props,targets}]
indent_size = 2

[*.{rs,go}]
indent_style = tab
