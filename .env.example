# ============================================================
# Portara 环境变量（v0.6.5）
#
#   cp .env.example .env
#
# 语义约定（逐条标注在每个变量上）：
#   [默认]       不设置时程序内使用的值
#   [必填]       生产必须显式提供；开发模式缺失会回退到内置弱值并打印启动告警
#   [生产必须改] 开发可留默认，对外部署前必须换成自己的值
#   [可选]       不设置即关闭该行为
#
# 优先级：**已存在的环境变量永远压过 .env 文件**（容器注入、测试夹具都靠这条），
# 加载顺序为 仓库根 .env → server/.env，先到先得、不覆盖。
# ============================================================

# ------------------------------------------------------------
# 服务监听
# ------------------------------------------------------------
# [默认 52740] 单端口同时提供数据面 /v1、控制面 /api 与前端产物
PORTARA_PORT=52740
# [默认 0.0.0.0] 监听地址；只想本机访问就写 127.0.0.1
PORTARA_HOST=0.0.0.0

# ------------------------------------------------------------
# 密钥与管理员（生产必须改）
# ------------------------------------------------------------
# [必填] 上游渠道密钥的加密主密钥，**必须是 32 字节的 base64**，否则启动直接报错。
#        生成：openssl rand -base64 32
#        缺失时开发模式回退到内置弱密钥并高声告警 —— 生产绝不可留空。
PORTARA_MASTER_KEY=
# [必填] 管理会话 JWT 的签名密钥。生成：openssl rand -hex 32
#        缺失时同样回退到内置弱密钥 + 启动告警。
PORTARA_SESSION_SECRET=

# [默认 admin] 初始管理员的用户名
PORTARA_ADMIN_USERNAME=admin
# [必填 / 生产必须改] 初始管理员口令，仅在「该用户名尚不存在」时用于创建账号，之后不再覆盖。
#        下面的 change-me-before-start 只是占位，**必须替换**。
#        留空则随机生成 12 字节口令并打印一次，登录后请立即修改；
#        若仍沿用早期的默认口令，服务启动会打印安全告警（判定逻辑见 server/src/bootstrap.ts）。
PORTARA_ADMIN_PASSWORD=change-me-before-start

# ------------------------------------------------------------
# 管理会话（access + refresh 双令牌）
# ------------------------------------------------------------
# [默认 false] 生产走 HTTPS 时置 true，refresh Cookie 会带上 Secure 标记
PORTARA_COOKIE_SECURE=false
# [默认 15] access token 有效期（分钟）。故意很短：它是无状态 JWT，签发后收不回来
PORTARA_ACCESS_TTL_MINUTES=15
# [默认 30] refresh token 有效期（天）。这才是「记住我」的时长，可撤销、每次刷新轮换
PORTARA_REFRESH_TTL_DAYS=30
# [默认 30] 轮换宽限窗口（秒）。多标签页并发刷新时，落在窗口内的旧令牌走同族继任者，
#           而不是被判为重放把用户踢下线
PORTARA_REFRESH_GRACE_SECONDS=30

# ---- 已废弃 ----
# DEPRECATED：PORTARA_SESSION_TTL_HOURS 已被 PORTARA_ACCESS_TTL_MINUTES 取代，设置后
# 该值会被**忽略**且启动时打印告警。长效会话请改用 PORTARA_REFRESH_TTL_DAYS。
# PORTARA_SESSION_TTL_HOURS=12

# ------------------------------------------------------------
# 依赖服务
# ------------------------------------------------------------
# [默认 postgres://portara:portara@127.0.0.1:52744/portara]
DATABASE_URL=postgres://portara:portara@127.0.0.1:52744/portara
# [默认 redis://127.0.0.1:52745] 限流计数、路由轮转、余额缓存、会话亲和表都在这里
REDIS_URL=redis://127.0.0.1:52745

# ------------------------------------------------------------
# 数据库 schema 与迁移
# ------------------------------------------------------------
# [默认 空 = public] 可选独立 schema，所有表建在其中。
#        用途：同一套库跑多套实例，尤其让端到端测试与开发数据彻底隔离。
#        只允许字母、数字、下划线。
# PORTARA_DB_SCHEMA=portara_smoke
# [可选] 置 1 则启动时跳过迁移。生产多副本部署时只让一个实例跑迁移
# PORTARA_SKIP_MIGRATE=1

# ------------------------------------------------------------
# 会话亲和（同一会话固定落在同一「渠道 + 账户」，复用上游前缀缓存）
# ------------------------------------------------------------
# [默认 1800] 亲和表的 TTL（秒）。太短等于没记住，太长会让渠道恢复后也回不去
PORTARA_AFFINITY_TTL_SECONDS=1800
# [默认 3600] 一条亲和记录的最大年龄（秒）。超过即视为陈旧并清除 ——
#        长会话会持续命中同一条 pin，只有 TTL 是忘不掉的；成功命中**不刷新**该时间，
#        只有新会话首次落 pin 或目标变更时才写
PORTARA_AFFINITY_MAX_AGE_SEC=3600
# [默认 false] 是否允许用「上下文指纹」做亲和。默认只认客户端显式给的 prompt_cache_key ——
#        指纹会让「固定系统提示 + 相同首条消息」的调用全部钉死在一个渠道上，加权轮转随之失效
PORTARA_AFFINITY_CONTEXT=false

# ------------------------------------------------------------
# 路由与并发（运行时设置，存在 settings 表里，在「系统设置」页维护）
# ------------------------------------------------------------
# 说明：以下调优参数**不再读取环境变量**。在管理面板
# 「系统设置 → 网关行为 → 路由与并发 / 故障转移与重试」里修改，保存后立即生效（无需重启）。
#   concurrencyCooldownSec    [默认 20，1..3600]        上游并发撞线后的短冷却秒数
#   concurrencyQueueTimeoutMs [默认 30000，0..300000]   所有候选渠道并发满载时的排队预算 ms；0 = 不排队
#   maxChannelAttempts        [默认 0，0..50]           一次请求最多尝试几个候选渠道；0 = 全部
#   attemptsPerCandidate      [默认 2，1..5]            同一（渠道, 账户）原地重试次数
#   maxFailoverPasses         [默认 3，1..10]           全部候选失败后整轮重来的次数
#   failoverBudgetMs          [默认 60000，0..600000]   故障转移总时间预算 ms；0 = 不做整轮重试
#   maxTotalAttempts          [默认 24，1..200]         单请求总上游尝试上限
#   maxAccountAttempts        [默认 0，0..100]          单个渠道内最多尝试几个账户；0 = 全部

# ------------------------------------------------------------
# 计费余额告警
# ------------------------------------------------------------
# [默认 1] 余额低于该阈值时 /api/billing/me 的 lowBalance 为 true，
#        个人资料页显示预警徽章（不再等到被 402 才发现）。
#        money 套餐直接比金额；credits 套餐按兑换率换算；tokens 套餐按原始数值比较。
PORTARA_BILLING_LOW_BALANCE_USD=1

# ------------------------------------------------------------
# 冷却与熔断
# ------------------------------------------------------------
# 说明：冷却时长与「窗口打满即跳过」是**运行时设置**，存在 settings 表里、
# 由管理面板「设置」页维护，不走环境变量：
#   accountFailureCooldownSec [默认 3600] 普通失败（超时 / 5xx / 连接失败）的冷却秒数；
#                                          401/403 另有更长下限，429 优先取上游 Retry-After
#   skipExhaustedWindows     [默认 开]     任一用量窗口打满的账户直接跳过（需配了余额适配器）
#   usageCacheTtlSec         [默认 300]    余额/用量快照的缓存秒数，用于避开上游限频

# ------------------------------------------------------------
# 前端产物
# ------------------------------------------------------------
# [默认 web/dist] 单端口托管的静态产物目录；镜像里或产物在别处时才需要指定
# PORTARA_WEB_DIST=

# ------------------------------------------------------------
# 访问代理（与 PORTARA_* 无关：代理在管理面板「访问代理」中维护）
# ------------------------------------------------------------
# 网关不读取 HTTP_PROXY / HTTPS_PROXY 之类的环境变量。渠道的出站代理是**数据库里的
# 实体**（/api/proxies），在渠道编辑页按渠道选用，支持直连与批量延迟对比。

# ------------------------------------------------------------
# 仅供 docker compose / 镜像构建使用（应用本身不读）
# ------------------------------------------------------------
# [默认 portara] compose 里 PostgreSQL 容器的口令；务必与 DATABASE_URL 中的口令一致
POSTGRES_PASSWORD=portara
