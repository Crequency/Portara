# ============================================================
# Portara 环境变量
# 复制为 .env 后修改：cp .env.example .env
# ============================================================

# ---- 服务 ----
PORTARA_PORT=52740
PORTARA_HOST=0.0.0.0

# ---- 安全（生产环境必须修改）----
# 上游渠道密钥的加密主密钥：openssl rand -base64 32
PORTARA_MASTER_KEY=
# 管理会话 JWT 签名密钥：openssl rand -hex 32
PORTARA_SESSION_SECRET=
# 生产走 HTTPS 时置 true（Cookie 加 Secure 标记）
PORTARA_COOKIE_SECURE=false
# 管理会话有效期（小时）
PORTARA_SESSION_TTL_HOURS=12

# ---- 初始管理员（首次启动时创建，之后不再覆盖）----
PORTARA_ADMIN_USERNAME=admin
PORTARA_ADMIN_PASSWORD=portara-admin

# ---- 依赖（开发模式：连 compose 暴露到宿主机的端口）----
DATABASE_URL=postgres://portara:portara@127.0.0.1:52744/portara
REDIS_URL=redis://127.0.0.1:52745

# ---- 前端产物目录（单端口托管；留空用内置默认值）----
# PORTARA_WEB_DIST=

# ---- 其他 ----
# 启动时跳过迁移（生产多副本时只让一个实例跑迁移）
# PORTARA_SKIP_MIGRATE=1

# ---- 仅供 compose 使用 ----
POSTGRES_PASSWORD=portara
